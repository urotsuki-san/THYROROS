{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/urotsuki-san/THYROROS/raw/main/schemas/run-contract.schema.json",
  "title": "THYROROS Run Contract",
  "description": "Structural schema for THYROROS Run Contract v1. The normative Python validator applies additional semantic and portability checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "run",
    "subject",
    "authority",
    "budget",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "const": "thyroros.run-contract"
    },
    "version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_digest", "created_at", "expires_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run_[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "task_digest": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "expires_at": {
          "$ref": "#/$defs/rfc3339"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_revision", "workspace_digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspace_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "deny",
        "network",
        "process",
        "secrets",
        "maximum_effect"
      ],
      "properties": {
        "read": {
          "$ref": "#/$defs/pathList"
        },
        "write": {
          "$ref": "#/$defs/pathList"
        },
        "deny": {
          "$ref": "#/$defs/pathList"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "allow"],
          "properties": {
            "default": {
              "const": "deny"
            },
            "allow": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/networkRule"
              }
            }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_images", "max_children"],
          "properties": {
            "allowed_images": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260,
                "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
              }
            },
            "max_children": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^secret:[a-z0-9][a-z0-9._/-]{2,255}$"
          }
        },
        "maximum_effect": {
          "enum": [
            "PURE",
            "READ_IDEMPOTENT",
            "WRITE_IDEMPOTENT",
            "AT_MOST_ONCE",
            "RECONCILE_REQUIRED",
            "IRREVERSIBLE"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "memory_mib", "network_requests"],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1048576
        },
        "network_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "forbidden_diff"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "forbidden_diff": {
          "$ref": "#/$defs/pathList"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "pathList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pathPattern"
      }
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Portable relative path pattern. Wildcards are whole segments: * or **. The normative validator additionally rejects traversal, controls, reserved device names, and non-NFC text.",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
    },
    "networkRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "scheme", "host", "port", "path_prefix"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
          }
        },
        "scheme": {
          "const": "https"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/[^\\\\?#%\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_seconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    }
  }
}
